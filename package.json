{
  "name": "notebooklm-styles-prompt",
  "version": "1.0.0",
  "description": "Showcase website for NotebookLM Slide Styles collection",
  "type": "module",
  "scripts": {
    "build:data": "node scripts/build-data.js",
    "validate": "node scripts/validate-styles.js",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "similarity": "node scripts/check-similarity.js",
    "readme": "node scripts/generate-readme.js",
    "readme:check": "node scripts/generate-readme.js --check",
    "dev": "npm run build:data && astro dev",
    "build": "npm run build:data && astro build && node scripts/flat-sitemap.js",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/carbon": "^1.2.20",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "unplugin-icons": "^23.0.1",
    "vite": "^6.3.1",
    "vitest": "^3.1.1"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.2",
    "astro": "^6.1.9",
    "js-yaml": "^5.5.0"
  }
}
