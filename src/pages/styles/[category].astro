---
import Layout from '../../layouts/Layout.astro';
import StyleCard from '../../components/StyleCard.astro';
// We import the generated JSON to know which pages to generate
import stylesData from '../../../public/data/styles.json';

export function getStaticPaths() {
  return stylesData.categories.map(cat => ({
    params: { category: cat.id },
    props: { name: cat.name, styles: cat.styles }
  }));
}

const { category } = Astro.params;
const { name, styles } = Astro.props;

const PAGE_SIZE = 12; // keep in sync with itemsToShow in app.js
const initialStyles = styles.slice(0, PAGE_SIZE);
---

<Layout category={category} title={`${name} — NotebookLM Styles`}>
  <main id="app" data-category={category}>
    <header class="hero">
      <div class="hero__container">
        <h1 class="hero__title">{name}</h1>
        <p class="hero__subtitle">
          <span id="style-count">{styles.length}</span> curated YAML prompts in this category
        </p>
      </div>
    </header>

    <section class="grid-section">
      <div id="styles-grid" class="bento-grid">
        {initialStyles.map((style) => <StyleCard style={style} />)}
      </div>

      <div id="pagination" class="pagination" hidden={styles.length <= PAGE_SIZE}>
        <button id="load-more" class="load-more-btn">Explore More Styles</button>
      </div>

      <p id="empty-state" class="empty-state" hidden>
        No styles in this category yet. Check back soon.
      </p>
    </section>
  </main>
</Layout>
