---
import Layout from '../../layouts/Layout.astro';
import StyleCard from '../../components/StyleCard.astro';
import SearchBar from '../../components/SearchBar.astro';
// We import the generated JSON to know which pages to generate
import stylesData from '../../../public/data/styles.json';

export function getStaticPaths() {
  return stylesData.categories.map(cat => ({
    params: { category: cat.id },
    props: { name: cat.name, styles: cat.styles }
  }));
}

const { category } = Astro.params;
const { name, styles } = Astro.props;

const PAGE_SIZE = 12; // keep in sync with itemsToShow in app.js
const initialStyles = styles.slice(0, PAGE_SIZE);

const examples = styles.slice(0, 3).map((s) => s.name).join(', ');
const description = `${styles.length} ${name} styles for NotebookLM slides, such as ${examples}. Preview each one and copy its YAML prompt.`;
const pageUrl = new URL(`/styles/${category}/`, Astro.site).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `${name} — NotebookLM Styles`,
    url: pageUrl,
    numberOfItems: styles.length,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: String(Astro.site) },
      { '@type': 'ListItem', position: 2, name: 'Styles', item: new URL('/styles', Astro.site).href },
      { '@type': 'ListItem', position: 3, name, item: pageUrl },
    ],
  },
];
---

<Layout category={category} title={`${name} — NotebookLM Styles`} description={description} jsonLd={jsonLd}>
  <main id="app" data-category={category}>
    <header class="hero">
      <div class="hero__container">
        <h1 class="hero__title">{name}</h1>
        <p class="hero__subtitle">
          <span id="style-count">{styles.length}</span> curated YAML prompts<span id="category-note"> in this category</span>
        </p>
        <SearchBar />
      </div>
    </header>

    <section class="grid-section">
      <div id="styles-grid" class="bento-grid">
        {initialStyles.map((style) => <StyleCard style={style} />)}
      </div>

      <div id="pagination" class="pagination" hidden={styles.length <= PAGE_SIZE}>
        <button id="load-more" class="load-more-btn">Explore More Styles</button>
      </div>

      <p id="empty-state" class="empty-state" hidden>
        No styles in this category yet. Check back soon.
      </p>
    </section>
  </main>
</Layout>
