---
/** Filter chips for the style lists. Shown by app.js once JavaScript is available. */
import stylesData from '../../public/data/styles.json';

const { showCategories = false } = Astro.props;
---

<div class="filters" id="filter-bar" hidden>
  {
    showCategories && (
      <div
        class="filters__group"
        role="group"
        aria-label="Category"
        data-i18n-aria="filterCategory"
      >
        <button
          type="button"
          class="chip"
          data-filter="category"
          data-value="all"
          aria-pressed="true"
          data-i18n="navAll">All Styles</button
        >
        {stylesData.categories.map((category) => (
          <button
            type="button"
            class="chip"
            data-filter="category"
            data-value={category.id}
            aria-pressed="false"
          >
            <span aria-hidden="true">{category.emoji}</span>
            <span data-i18n={`nav-${category.id}`}>{category.name}</span>
          </button>
        ))}
      </div>
    )
  }
  <div class="filters__group" role="group" aria-label="Tone" data-i18n-aria="filterTone">
    <button
      type="button"
      class="chip"
      data-filter="tone"
      data-value="all"
      aria-pressed="true"
      data-i18n="toneAll">Any tone</button
    >
    <button
      type="button"
      class="chip"
      data-filter="tone"
      data-value="light"
      aria-pressed="false"
      data-i18n="toneLight">Light</button
    >
    <button
      type="button"
      class="chip"
      data-filter="tone"
      data-value="dark"
      aria-pressed="false"
      data-i18n="toneDark">Dark</button
    >
    <button
      type="button"
      class="chip"
      data-filter="tone"
      data-value="colorful"
      aria-pressed="false"
      data-i18n="toneColorful">Colorful</button
    >
  </div>
  <label class="filters__sort">
    <span data-i18n="filterSort">Sort by</span>
    <select data-filter="sort">
      <option value="default" data-i18n="sortDefault">Default order</option>
      <option value="az" data-i18n="sortAz">A–Z</option>
      <option value="new" data-i18n="sortNew">Newest</option>
    </select>
  </label>
</div>
