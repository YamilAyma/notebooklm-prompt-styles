---
/** Global style search. Shown by app.js once JavaScript is available. */
---

<div class="search" role="search" id="search-bar" hidden>
  <input
    id="style-search"
    class="search__input"
    type="search"
    autocomplete="off"
    spellcheck="false"
    placeholder="Search styles…"
    aria-label="Search styles"
    data-i18n="searchPlaceholder"
    data-i18n-aria="searchLabel"
  />
  <kbd class="search__hint" aria-hidden="true">/</kbd>
</div>
